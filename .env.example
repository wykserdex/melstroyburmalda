# =============================================================================
# Telegram Outreach Platform — environment variables
# Copy to .env and fill in. NEVER commit .env to git.
# =============================================================================

# --- Telegram (outreach account) ---------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=outreach
# Optional: path to a session file with the existing StringSession
# TELEGRAM_STRING_SESSION=

# --- Telegram (management bot, separate account) -----------------------------
BOT_TOKEN=
BOT_ALLOWED_USERS=

# --- LLM (Ollama) ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT_SECONDS=60

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://outreach:outreach@localhost:5432/outreach
# For quick local dev without Postgres you can use:
# DATABASE_URL=sqlite+aiosqlite:///./outreach.db

# --- Search / scanning -------------------------------------------------------
KEYWORDS=барахолка,объявления,вакансии,работа,услуги
CITIES=
MIN_SUBSCRIBERS=200
MAX_SAMPLE_MESSAGES=50
EXCLUDED_CHANNELS=
EXCLUDED_KEYWORDS=

# --- Rate limits -------------------------------------------------------------
DAILY_MESSAGE_LIMIT=40
MIN_DELAY_SECONDS=120
MAX_DELAY_SECONDS=600
PER_RECIPIENT_COOLDOWN_HOURS=24
GLOBAL_HOURLY_LIMIT=20

# --- Qualification -----------------------------------------------------------
RELEVANCE_THRESHOLD=0.6
CONFIDENCE_THRESHOLD=0.75

# --- Workflow ----------------------------------------------------------------
AUTO_APPROVE=false
APPROVAL_TIMEOUT_HOURS=48
FOLLOWUP_DELAY_HOURS=72
MAX_FOLLOWUPS=1

# --- Retries -----------------------------------------------------------------
MAX_RETRIES=5
RETRY_BASE_DELAY=2.0
RETRY_MAX_DELAY=600.0

# --- LLM / Generation --------------------------------------------------------
PROMPT_VERSION=v1
SIMILARITY_THRESHOLD=0.8

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
ENVIRONMENT=development
